<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyValidations</PackageId>
    <Version>1.1.0-beta.3</Version>
    <Authors>Jorge Durban Antunano</Authors>
    <Description>Small compile-time validation for application-layer commands, with generated runners, DI-friendly custom rules, and pipeline-friendly validation primitives.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/george2006/TinyValidations</PackageProjectUrl>
    <RepositoryUrl>https://github.com/george2006/TinyValidations</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>validation;source-generator;dotnet;dependency-injection;aspnetcore;mediatr;tinydispatcher;opentelemetry;observability</PackageTags>
    <PackageReleaseNotes>TinyValidations 1.1.0-beta.3 fixes validation generation safety: invalid declarations no longer suppress unrelated validations, and TV0001 through TV0006 are now compilation errors. Built-in rules support compile-time constants and named arguments while preserving constant types, conversions, and message text. Invalid or null regex patterns are reported during generation.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyValidations.SourceGen\TinyValidations.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\TinyValidations.SourceGen\bin\$(Configuration)\netstandard2.0\TinyValidations.SourceGen.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
